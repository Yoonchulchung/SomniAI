# Environment Variables Example
# Copy this file to .env and update the values

# Timezone
TZ=Asia/Seoul

# MySQL Configuration
MYSQL_ROOT_PASSWORD=local-root-pass
MYSQL_USER=somniai
MYSQL_PASSWORD=somniai-pass
MYSQL_DATABASE=somniai
MYSQL_PORT=3306

# Application Configuration
APP_NAME=SomniAI
APP_VERSION=2.0.0
DEBUG=false

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
WORKERS=1
RELOAD=false
LOG_LEVEL=info

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=somniai
DB_PASSWORD=somniai-pass
DB_NAME=somniai
DB_ECHO=false

# Security Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=*

# MQTT Configuration
MQTT_ADDRESS=localhost
MQTT_PORT=1883
MQTT_TOPIC=somniai/pillow/esp32

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_AIR=somniai-air-images
KAFKA_TOPIC_SIDE=somniai-side-images
KAFKA_CONSUMER_GROUP=somniai-consumer-group
