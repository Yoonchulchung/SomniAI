syntax = "proto3";
// 패키지 이름은 Go와 Python 코드를 생성할 때 사용됩니다.
package control; 

// ----------------------------------------------------
// 1. Python 모델로 보내는 입력 데이터 (Go 워커 -> Python)
// ----------------------------------------------------
message ControlInput {
    // 최근 5~10분 심박수 중앙값 (S와 γ 계산용)
    double hr_med = 1;      
    
    // 누워있을 때 CVA 값 (CA* 계산용)
    double cva_upright = 2; 

    // 현재 포즈 추정으로 계산된 목 관절 각도 (U 계산용)
    double current_angle = 3; 
}

// ----------------------------------------------------
// 2. Go 워커로 돌아오는 출력 데이터 (Python -> Go 워커)
// ----------------------------------------------------
message ControlOutput {
    // 최종 베개 제어 명령 U (펌프에 전달할 값)
    double command_u = 1;   
}

// ----------------------------------------------------
// 3. 서비스 (함수) 정의
// ----------------------------------------------------
service Controller {
    // Go 워커는 ControlInput을 보내고, Python 모델은 ControlOutput을 반환합니다.
    rpc GetControlCommand(ControlInput) returns (ControlOutput);
}
