/* ---------- 유틸 (HTTP 버전과 동일) ---------- */
// 릴레이: 액티브 LOW
inline void valveWrite(int idx, bool on) {
  digitalWrite(PIN_VALVE[idx], RELAY_ACTIVE_LOW ? !on : on);
}
inline void valveAllOff() {
  for (int i = 0; i < 4; ++i) valveWrite(i, false);
}

inline void pumpDir(int idx, bool forward) {
  digitalWrite(PIN_PUMP_DIR[idx], forward ? HIGH : LOW);
}
inline void pumpWrite(int idx, uint8_t duty) {
  ledcWrite(PIN_PUMP_EN[idx], duty);
}

inline void pumpsAllOff() {
  for (int i = 0; i < 4; ++i) {
    pumpWrite(i, 0);
    digitalWrite(PIN_PUMP_DIR[i], LOW);
  }
}
inline void allStop() {
  pumpsAllOff();
  valveAllOff();
}

// === on/off 패턴 ===
inline void pumpOn(int idx, uint8_t duty = DUTY_MAX) {
  valveAllOff();
  delay(DEAD_MS);           // 밸브 전부 닫고 데드타임
  pumpDir(idx, true);       // 주입 방향
  pumpWrite(idx, duty);
}
inline void pumpOff(int idx) {
  pumpWrite(idx, 0);
  digitalWrite(PIN_PUMP_DIR[idx], LOW);
}

inline void valveOnIdx(int idx) {
  pumpsAllOff();
  delay(DEAD_MS);           // 모든 펌프 정지 후 밸브 오픈
  valveWrite(idx, true);    // 액티브 LOW → LOW 출력
}
inline void valveOffIdx(int idx) {
  valveWrite(idx, false);
}

/* ---------- 시간 기반 펌프/밸브 동작 ---------- */
static void run_inflate_pump_time(int i, float seconds, uint8_t duty = DUTY_MAX) {
  if (seconds <= 0.0f) return;
  uint32_t ms = (uint32_t)(seconds * 1000.0f);
  logf("[ACT] inflate idx=%d, t=%.2fs", i, (double)seconds);
  pumpOn(i, duty);
  delay(ms);            // delay 동안 그대로 ON
  pumpOff(i);
}

static void run_deflate_valve_time(int i, float seconds) {
  if (seconds <= 0.0f) return;
  uint32_t ms = (uint32_t)(seconds * 1000.0f);
  logf("[ACT] deflate idx=%d, t=%.2fs", i, (double)seconds);
  valveOnIdx(i);
  delay(ms);            // delay 동안 그대로 ON
  valveOffIdx(i);
}

/* ---------- Wi-Fi ---------- */
void WiFiTask(void*) {
  for (;;) {
    if (WiFi.status() != WL_CONNECTED) {
      WiFi.begin(WIFI_SSID, WIFI_PASS);
      uint32_t t0 = millis();
      while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000)
        vTaskDelay(pdMS_TO_TICKS(500));
      if (WiFi.status() == WL_CONNECTED) {
        xEventGroupSetBits(g_events, WIFI_CONNECTED_BIT);
        logf("[WIFI] connected: %s", WiFi.localIP().toString().c_str());
      } else {
        xEventGroupClearBits(g_events, WIFI_CONNECTED_BIT);
        vTaskDelay(pdMS_TO_TICKS(5000));
      }
    } else {
      vTaskDelay(pdMS_TO_TICKS(3000));
    }
  }
}

