/* ---------- 목 각도 명령 핸들러 (neck_angle → pillow_angle 계산) ---------- */
static void handleNeckAngleCommand(int neckAngle) {
  if (auto_mode) {
    logf("[ANGLE] auto_mode 이미 ON → neck=%d 무시", neckAngle);
    return;
  }
  // 목 각도 → 목표 목+베개 각도
  float pillowAngle = NECK_TO_PILLOW_A - NECK_TO_PILLOW_B * (float)neckAngle;
  angle_command_deg     = pillowAngle;
  angle_command_pending = true;

  logf("[ANGLE] neck=%d → pillow_angle=%.1f (queued)", neckAngle, (double)pillowAngle);
}

/* ---------- MQTT 콜백 ---------- */
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  // somniai/neck/angle: 정수 neck angle
  if (strcmp(topic, TOPIC_NECK_ANGLE) == 0) {
    String msg; msg.reserve(length + 1);
    for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
    int neckAngle = msg.toInt();
    logf("[MQTT] neck angle payload='%s' → %d", msg.c_str(), neckAngle);
    handleNeckAngleCommand(neckAngle);
  }
  // somniai/pillow/motor: 정수 motor_id
  else if (strcmp(topic, TOPIC_MOTOR) == 0) {
    String msg; msg.reserve(length + 1);
    for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
    int motorId = msg.toInt();
    logf("[MQTT] motor_id=%d", motorId);

    if (motorId == 0) {
      if (!auto_mode) {
        auto_mode       = true;
        auto_state      = AUTO_BASELINE;
        baselineCount   = 0;
        currHrCount     = 0;
        baselineStartMs = millis();
        hrWindowStartMs = millis();
        first_step_done = false;
        last_action     = ACT_NONE;
        HR_ref  = 0.0f;
        HR_prev = 0.0f;
        e_prev  = 0.0f;
        // ★ pump_budget 리셋하지 않음 → 초기 각도 보정에 쓴 것도 그대로 반영
        logf("[AUTO][MQTT] motor_id=0 → auto_mode ON, baseline 시작 (budget=%.2f)",
             (double)pump_budget);
      } else {
        logf("[AUTO][MQTT] motor_id=0 ignored (already auto_mode)");
      }
    } else if (motorId > 0) {
      if (!auto_mode) {
        auto_mode  = false;
        auto_state = AUTO_IDLE;
        if (g_motor_queue) {
          xQueueSend(g_motor_queue, &motorId, 0);
        }
        logf("[AUTO][MQTT] motor_id>0 (수동), auto_mode OFF");
      } else {
        logf("[AUTO][MQTT] motor_id>0 ignored (auto_mode locked)");
      }
    }
  }
  else if (strcmp(topic, TOPIC_POSE) == 0) {
    // pose 데이터는 일단 로그만
    if (!kPlotterMode) {
      String msg; msg.reserve(length + 1);
      for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
      logf("[POSE][MQTT] %s", msg.c_str());
    }
  }
}

/* ---------- MQTT 연결 태스크 ---------- */
void ensureMQTT() {
  mqtt.setServer(MQTT_HOST, MQTT_PORT);
  mqtt.setCallback(mqttCallback);

  while (!mqtt.connected()) {
    if (!(xEventGroupGetBits(g_events) & WIFI_CONNECTED_BIT)) {
      vTaskDelay(pdMS_TO_TICKS(1000));
      continue;
    }
    String clientId = "somniai-esp32-";
    clientId += String((uint32_t)ESP.getEfuseMac(), HEX);

    logf("[MQTT] connecting... %s", clientId.c_str());
    if (mqtt.connect(clientId.c_str())) {
      logf("[MQTT] connected");
      mqtt.subscribe(TOPIC_NECK_ANGLE);
      mqtt.subscribe(TOPIC_MOTOR);
      mqtt.subscribe(TOPIC_POSE);
      mqtt.publish(TOPIC_STATUS, "ESP32 online");
      logf("[MQTT] subscribed: neck/angle, pillow/motor, pose");
    } else {
      logf("[MQTT] failed rc=%d, retry 2s", mqtt.state());
      vTaskDelay(pdMS_TO_TICKS(2000));
    }
  }
}

void MQTTTask(void*) {
  // Wi-Fi 연결될 때까지 대기
  xEventGroupWaitBits(g_events, WIFI_CONNECTED_BIT, pdFALSE, pdTRUE, portMAX_DELAY);
  ensureMQTT();
  for (;;) {
    if (!mqtt.connected()) ensureMQTT();
    mqtt.loop();
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

