/* ---------- MAX30102 ---------- */
MAX30105 sensor;
const byte RATE_SIZE = 8;
byte rates[RATE_SIZE];
byte rateSpot = 0;
long lastBeat = 0;

void BPMTask(void*) {
  // I2C 초기화 (HTTP 버전과 동일: SDA=25, SCL=26)
  Wire.begin(25, 26);
  Wire.setClock(400000);

  Serial.println("[MAX] BPMTask start, begin() 호출");

  if (!sensor.begin(Wire)) {
    Serial.println("[MAX] sensor.begin(Wire) FAIL! BPMTask 종료");
    bpm = 0;
    beatAvg = 0;
    for (;;) {
      vTaskDelay(pdMS_TO_TICKS(1000));
    }
  }

  Serial.println("[MAX] sensor.begin OK, setup() 진행");

  sensor.setup(0x24, 4, 2, 100, 411, 4096);
  sensor.setPulseAmplitudeIR(0x24);
  sensor.setPulseAmplitudeRed(0x10);
  sensor.setPulseAmplitudeGreen(0x00);

  uint32_t lastDebugPrint = 0;

  for (;;) {
    long ir = sensor.getIR();

    if (!kPlotterMode) {
      uint32_t now = millis();
      if (now - lastDebugPrint >= 500) {
        lastDebugPrint = now;
        Serial.printf("[MAX] IR=%ld bpm=%.1f avg=%.1f\n",
                      ir, (double)bpm, (double)beatAvg);
      }
    }

    if (ir > 8000) {  // 접촉 감지 임계값
      if (checkForBeat(ir)) {
        long now = millis();
        long dt  = now - lastBeat;
        lastBeat = now;
        if (dt > 260 && dt < 2000) {      // 30~230 bpm
          float b = 60.0f / (dt / 1000.0f);
          if (b >= 30 && b <= 220) {
            rates[rateSpot++] = (byte)b;
            rateSpot %= RATE_SIZE;
            int s = 0;
            for (byte i = 0; i < RATE_SIZE; i++) s += rates[i];
            bpm     = b;
            beatAvg = s / (float)RATE_SIZE;
          }
        }
      }
    } else {
      bpm = 0;  // beatAvg는 이전 값 유지
    }
    vTaskDelay(pdMS_TO_TICKS(10));  // ~100Hz
  }
}

/* ---------- 자동 제어(beatAvg 기반 HR_ref + P 제어 + 펌프 안전 + 초기 angle) ---------- */

// 작은 배열 median 계산 (baseline용)
static float median_of(float* arr, int n) {
  if (n <= 0) return 0.0f;
  float tmp[HR_BUF_SIZE];
  int m = n;
  if (m > HR_BUF_SIZE) m = HR_BUF_SIZE;
  for (int i = 0; i < m; ++i) tmp[i] = arr[i];
  // 삽입정렬
  for (int i = 1; i < m; ++i) {
    float key = tmp[i];
    int j = i - 1;
    while (j >= 0 && tmp[j] > key) {
      tmp[j + 1] = tmp[j];
      j--;
    }
    tmp[j + 1] = key;
  }
  if (m % 2 == 1) return tmp[m / 2];
  else return 0.5f * (tmp[m / 2 - 1] + tmp[m / 2]);
}

void ControlTask(void*) {
  // 펌프/밸브 핀 초기화
  for (int i = 0; i < 4; ++i) {
    pinMode(PIN_PUMP_DIR[i], OUTPUT);
    digitalWrite(PIN_PUMP_DIR[i], LOW);
  }
  for (int i = 0; i < 4; ++i) {
    pinMode(PIN_VALVE[i], OUTPUT);
    valveWrite(i, false);
  }
  // PWM attach (핀 기반 API, 0번 펌프 EN=14가 실제 사용)
  for (int i = 0; i < 4; ++i) {
    ledcAttach(PIN_PUMP_EN[i], PWM_FREQ, PWM_RES);
    ledcWrite(PIN_PUMP_EN[i], 0);
  }

  allStop();

  last_pulse_ms = millis();
  uint32_t lastSampleMs = millis();  // 1초에 한 번 HR 샘플링용

  for (;;) {
    uint32_t now = millis();

    // ---------- auto_mode 가 false일 때: 초기 angle 명령 먼저 처리 ----------
    if (!auto_mode) {
      if (angle_command_pending) {
        // MQTT에서 넘어온 "목 angle → pillow_angle" 결과 처리
        float angleDeg = angle_command_deg;
        angle_command_pending = false;   // 한 번만 처리

        float deltaDeg = angleDeg - BASE_ANGLE_DEG;
        if (deltaDeg <= 0.0f) {
          logf("[ANGLE] pillow_angle=%.1f <= base=%.1f → inflate SKIP (budget=%.2f)",
               (double)angleDeg, (double)BASE_ANGLE_DEG, (double)pump_budget);
        } else {
          float raw_sec    = deltaDeg / ANGLE_RATE_DEG_PER_SEC;     // 이론 펌프 시간
          float max_sec    = pump_budget / PUMP_CONSUME_PER_SEC;    // budget으로 제한
          float actual_sec = raw_sec;
          if (actual_sec > max_sec) actual_sec = max_sec;

          if (actual_sec <= 0.0f || pump_budget <= 0.0f) {
            logf("[ANGLE][SAFE] pump_budget=%.2f → inflate SKIP", (double)pump_budget);
          } else {
            // 펌프 속도 5mm/s 기반으로 높이 변화 계산
            float step_mm = actual_sec * INFLATE_RATE_MM_S;
            logf("[ANGLE] pillow_angle=%.1f, delta=%.1fdeg, raw=%.2fs, actual=%.2fs, step=%.1fmm (budget=%.2f)",
                 (double)angleDeg, (double)deltaDeg,
                 (double)raw_sec, (double)actual_sec,
                 (double)step_mm, (double)pump_budget);

            int idx = 0; // 0번 펌프 사용
            run_inflate_pump_time(idx, actual_sec, DUTY_MAX);
            last_action = ACT_INFLATE;

            // budget 소모
            pump_budget -= actual_sec * PUMP_CONSUME_PER_SEC;
            if (pump_budget < 0.0f) pump_budget = 0.0f;

            // 높이 추정 업데이트
            H_est_mm += step_mm;
            if (H_est_mm > H_MAX_MM) H_est_mm = H_MAX_MM;
          }
        }

        vTaskDelay(pdMS_TO_TICKS(50));
        continue;   // 다음 루프
      }

      // angle 명령도 없고 auto_mode=false 이면 idle
      auto_state = AUTO_IDLE;
      allStop();
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }

    // ---------- 여기부터는 auto_mode == true (기존 baseline + control 로직) ----------

    // 1초마다 beatAvg를 버퍼에 기록
    if (now - lastSampleMs >= 1000) {
      lastSampleMs = now;

      if (auto_state == AUTO_BASELINE) {
        if (baselineCount < HR_BUF_SIZE) {
          baselineBuf[baselineCount++] = beatAvg;
        }
        logf("[BASE] t=%lus, beatAvg=%.1f, samples=%d",
             (unsigned long)((now - baselineStartMs) / 1000UL),
             (double)beatAvg, baselineCount);
      } else if (auto_state == AUTO_CONTROL) {
        if (currHrCount < HR_BUF_SIZE) {
          currHrBuf[currHrCount++] = beatAvg;
        }
      }
    }

    // -------- 상태별 처리 --------
    if (auto_state == AUTO_BASELINE) {
      if (now - baselineStartMs >= BASELINE_MS && baselineCount > 0) {
        HR_ref = median_of(baselineBuf, baselineCount);
        auto_state      = AUTO_CONTROL;
        hrWindowStartMs = now;
        currHrCount     = 0;
        first_step_done = false;
        last_action     = ACT_NONE;
        HR_prev         = HR_ref;
        e_prev          = 0.0f;
        logf("[AUTO] baseline 완료, HR_ref=%.1f", (double)HR_ref);
      }

    } else if (auto_state == AUTO_CONTROL) {
      if (now - hrWindowStartMs >= HR_WINDOW_MS) {
        float HR_curr = 0.0f;
        if (currHrCount > 0) {
          float sum = 0.0f;
          for (int i = 0; i < currHrCount; ++i) sum += currHrBuf[i];
          HR_curr = sum / (float)currHrCount;
        } else {
          HR_curr = beatAvg;
        }

        float e_curr     = HR_curr - HR_ref;
        float e_curr_abs = fabsf(e_curr);
        float e_prev_abs = fabsf(e_prev);

        logf("[CTRL] HR_ref=%.1f, HR_curr=%.1f, e=%.1f (|e_prev|=%.1f)",
             (double)HR_ref, (double)HR_curr,
             (double)e_curr, (double)e_prev_abs);

        hrWindowStartMs = now;
        currHrCount     = 0;

        if (e_curr_abs <= 5.0f) {
          // 허용 범위 내 → 움직이지 않음
          HR_prev = HR_curr;
          e_prev  = e_curr;
          logf("[CTRL] |e|<=5 → no move, keep H=%.1fmm (budget=%.2f)",
               (double)H_est_mm, (double)pump_budget);
        } else {
          float step_mm = 0.0f;

          if (!first_step_done) {
            // 첫 스텝: 무조건 2mm 내려가기 (밸브)
            dir = -1;
            step_mm = 2.0f;
            first_step_done = true;
            logf("[CTRL] first step: dir=-1 (down), step=%.2fmm", (double)step_mm);
          } else {
            bool flipped = false;
            if (e_curr_abs > e_prev_abs + 0.5f) {
              dir = -dir;
              flipped = true;
              logf("[CTRL] e worsened → flip dir → %d", dir);
            } else if (e_curr_abs < e_prev_abs - 0.5f) {
              logf("[CTRL] e improved → keep dir=%d", dir);
            } else {
              logf("[CTRL] e ~same → keep dir=%d", dir);
            }

            float Kp   = 0.5f;   // 1 bpm↑ 당 0.5mm
            float e_th = 5.0f;
            step_mm = Kp * (e_curr_abs - e_th);

            if (step_mm < 0.5f) step_mm = 0.5f;
            if (step_mm > 2.0f) step_mm = 2.0f;

            if (flipped) {
              step_mm *= 1.2f;
              if (step_mm > 2.0f) step_mm = 2.0f;
            }

            logf("[CTRL] P-step: step_mm=%.2f (dir=%d)", (double)step_mm, dir);
          }

          // 목표 높이 계산 (HTTP 버전 로직과 동일하게 H_target으로 clamp)
          float H_target = H_est_mm + (dir > 0 ? +step_mm : -step_mm);
          if (H_target < H_MIN_MM) H_target = H_MIN_MM;
          if (H_target > H_MAX_MM) H_target = H_MAX_MM;
          float planned_step = fabsf(H_target - H_est_mm);

          logf("[CTRL] H_est: %.1f → H_target=%.1f (planned_step=%.2f)",
               (double)H_est_mm, (double)H_target, (double)planned_step);

          if (planned_step > 0.0f) {
            if (dir > 0) {
              // ========= 펌프 방향 (inflate) → 펌프 budget 적용 =========
              float max_pump_sec  = pump_budget / PUMP_CONSUME_PER_SEC;
              float max_pump_step = max_pump_sec * INFLATE_RATE_MM_S;
              float actual_step   = planned_step;

              if (actual_step > max_pump_step) actual_step = max_pump_step;
              if (actual_step <= 0.0f || pump_budget <= 0.0f) {
                logf("[SAFE] pump_budget=%.2f → inflate SKIP", (double)pump_budget);
              } else {
                float actual_sec = actual_step / INFLATE_RATE_MM_S;
                logf("[SAFE] budget=%.2f, planned=%.2fmm, actual=%.2fmm (%.2fs)",
                     (double)pump_budget, (double)planned_step,
                     (double)actual_step, (double)actual_sec);

                int idx = 0;  // 항상 0번 펌프만 사용
                run_inflate_pump_time(idx, actual_sec, DUTY_MAX);
                last_action = ACT_INFLATE;

                // budget 소모
                pump_budget -= actual_sec * PUMP_CONSUME_PER_SEC;
                if (pump_budget < 0.0f) pump_budget = 0.0f;

                // 실제 올라간 만큼만 높이 반영
                H_est_mm += actual_step;
                if (H_est_mm > H_MAX_MM) H_est_mm = H_MAX_MM;
              }
            } else {
              // ========= 밸브 방향 (deflate) → budget 회복 =========
              float sec = planned_step / DEFLATE_RATE_MM_S;
              int idx = 0;  // 항상 0번 밸브만 사용
              run_deflate_valve_time(idx, sec);
              last_action = ACT_DEFLATE;

              // budget 회복
              pump_budget += sec * VALVE_RECOVER_PER_SEC;
              if (pump_budget > PUMP_BUDGET_MAX) pump_budget = PUMP_BUDGET_MAX;

              H_est_mm -= planned_step;
              if (H_est_mm < H_MIN_MM) H_est_mm = H_MIN_MM;

              logf("[SAFE] valve recover → pump_budget=%.2f", (double)pump_budget);
            }
          }

          HR_prev = HR_curr;
          e_prev  = e_curr;
        }
      }
    }

    vTaskDelay(pdMS_TO_TICKS(50)); // 기본 20Hz 루프
  }
}

/* ---------- 플로터(BPM,AvgBPM만 숫자 출력) ---------- */
void PlotTask(void*) {
  for (;;) {
    if (kPlotterMode) {
      Serial.printf("%.1f,%.1f\n", (double)bpm, (double)beatAvg);
    }
    vTaskDelay(pdMS_TO_TICKS(50));   // 20Hz
  }
}

/* ---------- setup/loop ---------- */
void setup() {
  Serial.begin(115200);
  delay(200);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);

  g_events = xEventGroupCreateStatic(&s_events_buf);
  g_motor_queue = xQueueCreateStatic(QUEUE_LEN, sizeof(int), s_mq_storage, &s_mq_struct);

  server.on("/", HTTP_GET, handle_root);
  server.on("/health", HTTP_GET, handle_health);
  server.onNotFound(handle_404);
  server.begin();

  xTaskCreatePinnedToCore(WiFiTask,   "WiFiTask",   4096, nullptr, 2, nullptr, 0);
  xTaskCreatePinnedToCore(MQTTTask,   "MQTTTask",   4096, nullptr, 1, nullptr, 1);
  xTaskCreatePinnedToCore(WorkerTask, "WorkerTask", 4096, nullptr, 1, nullptr, 1);
  xTaskCreatePinnedToCore(BPMTask,    "BPMTask",    4096, nullptr, 1, nullptr, 1);
  xTaskCreatePinnedToCore(ControlTask,"ControlTask",4096, nullptr, 1, nullptr, 1);
  xTaskCreatePinnedToCore(PlotTask,   "PlotTask",   2048, nullptr, 1, nullptr, 1);
}

void loop() {
  server.handleClient();   // /health 유지
}
