{
  "name": "MoJI",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "prepare": "cd .. && husky install .husky || true",
    "postinstall": "[ -d ../.git ] && cd .. && husky install .husky || echo 'Skipping husky (not in git repo)'"
  },
  "dependencies": {
    "@react-native-camera-roll/camera-roll": "^7.8.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/react-native-skia": "1.4.2",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "mqtt": "^5.3.5",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-native": "0.75.4",
    "react-native-gesture-handler": "2.21.0",
    "react-native-mmkv": "^2.12.2",
    "react-native-pressable-opacity": "^1.0.10",
    "react-native-reanimated": "3.15.5",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "^3.37.0",
    "react-native-static-safe-area-insets": "^2.2.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "^6.6.4",
    "react-native-vision-camera": "4.6.4",
    "react-native-worklets-core": "^1.3.3",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/runtime": "^7.24.7",
    "@react-native-community/cli": "latest",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@types/react": "^18.3.3",
    "@types/react-native-vector-icons": "^6.4.13",
    "@types/react-native-video": "^5.0.20",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.46.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.2.4",
    "react-native-codegen": "0.70.7",
    "typescript": "^5.1.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
